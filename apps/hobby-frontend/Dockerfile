# Build stage
FROM node:20-alpine AS builder
WORKDIR /app

ARG NEXT_PUBLIC_AUTHENTICATION_URL
ENV NEXT_PUBLIC_AUTHENTICATION_URL=${NEXT_PUBLIC_AUTHENTICATION_URL}
ARG NEXT_PUBLIC_MEDIA_URL
ENV NEXT_PUBLIC_MEDIA_URL=${NEXT_PUBLIC_MEDIA_URL}
ARG NEXT_PUBLIC_INTERACTION_URL
ENV NEXT_PUBLIC_INTERACTION_URL=${NEXT_PUBLIC_INTERACTION_URL}
ARG NEXT_PUBLIC_NOTIFICATION_URL
ENV NEXT_PUBLIC_NOTIFICATION_URL=${NEXT_PUBLIC_NOTIFICATION_URL}

ARG NEXT_PUBLIC_MIDDLEWARE_URL_CLIENTSIDE
ENV NEXT_PUBLIC_MIDDLEWARE_URL_CLIENTSIDE=${NEXT_PUBLIC_MIDDLEWARE_URL_CLIENTSIDE}

ARG NEXT_PUBLIC_MIDDLEWARE_URL_SERVERSIDE
ENV NEXT_PUBLIC_MIDDLEWARE_URL_SERVERSIDE=${NEXT_PUBLIC_MIDDLEWARE_URL_SERVERSIDE}
COPY package*.json ./

RUN npm ci

ARG NEXT_PUBLIC_MIDDLEWARE_URL
ENV NEXT_PUBLIC_MIDDLEWARE_URL=${NEXT_PUBLIC_MIDDLEWARE_URL}
ARG NEXT_PUBLIC_LIBRARY_SERVICE_URL
ENV NEXT_PUBLIC_LIBRARY_SERVICE_URL=${NEXT_PUBLIC_LIBRARY_SERVICE_URL}

COPY . .

RUN echo "[DEBUG] NEXT_PUBLIC_AUTHENTICATION_URL=$NEXT_PUBLIC_AUTHENTICATION_URL" && \
    echo "[DEBUG] NEXT_PUBLIC_MIDDLEWARE_URL_CLIENTSIDE=$NEXT_PUBLIC_MIDDLEWARE_URL_CLIENTSIDE" && \
    npm run build

# Production stage
FROM node:20-alpine AS production
WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/next.config.ts ./


CMD ["npm", "start"]