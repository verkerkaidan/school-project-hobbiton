# deps — install all dependencies (cached unless package.json changes)
FROM node:20-alpine AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci

# builder — compile the Next.js app
FROM node:20-alpine AS builder
WORKDIR /app

ARG NEXT_PUBLIC_AUTHENTICATION_URL
ARG NEXT_PUBLIC_MEDIA_URL
ARG NEXT_PUBLIC_INTERACTION_URL
ARG NEXT_PUBLIC_NOTIFICATION_URL
ARG NEXT_PUBLIC_MIDDLEWARE_URL_CLIENTSIDE
ARG NEXT_PUBLIC_MIDDLEWARE_URL_SERVERSIDE
ARG NEXT_PUBLIC_MIDDLEWARE_URL
ARG NEXT_PUBLIC_CHAT_SERVICE_URL
ARG NEXT_PUBLIC_WS_CHAT_SERVICE_URL
ARG NEXT_PUBLIC_LIBRARY_SERVICE_URL
ARG NEXT_PUBLIC_APP_VERSION

ENV NEXT_PUBLIC_AUTHENTICATION_URL=${NEXT_PUBLIC_AUTHENTICATION_URL} \
    NEXT_PUBLIC_MEDIA_URL=${NEXT_PUBLIC_MEDIA_URL} \
    NEXT_PUBLIC_INTERACTION_URL=${NEXT_PUBLIC_INTERACTION_URL} \
    NEXT_PUBLIC_NOTIFICATION_URL=${NEXT_PUBLIC_NOTIFICATION_URL} \
    NEXT_PUBLIC_MIDDLEWARE_URL_CLIENTSIDE=${NEXT_PUBLIC_MIDDLEWARE_URL_CLIENTSIDE} \
    NEXT_PUBLIC_MIDDLEWARE_URL_SERVERSIDE=${NEXT_PUBLIC_MIDDLEWARE_URL_SERVERSIDE} \
    NEXT_PUBLIC_MIDDLEWARE_URL=${NEXT_PUBLIC_MIDDLEWARE_URL} \
    NEXT_PUBLIC_CHAT_SERVICE_URL=${NEXT_PUBLIC_CHAT_SERVICE_URL} \
    NEXT_PUBLIC_WS_CHAT_SERVICE_URL=${NEXT_PUBLIC_WS_CHAT_SERVICE_URL} \
    NEXT_PUBLIC_LIBRARY_SERVICE_URL=${NEXT_PUBLIC_LIBRARY_SERVICE_URL} \
    NEXT_PUBLIC_APP_VERSION=${NEXT_PUBLIC_APP_VERSION}

COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

# dev — hot-reload development server
FROM node:20-alpine AS dev
WORKDIR /app
ENV NODE_ENV=development
COPY --from=deps /app/node_modules ./node_modules
COPY . .
CMD ["npm", "run", "dev"]

# production — minimal runtime image
FROM node:20-alpine AS production
WORKDIR /app
ENV NODE_ENV=production

COPY package*.json ./
RUN npm ci --omit=dev

COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/next.config.ts ./

CMD ["npm", "start"]