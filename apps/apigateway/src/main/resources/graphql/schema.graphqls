# schema.graphqls

type Mutation {
  toggleFollow(targetUserId: ID!, currentUserId: ID!): Boolean
  toggleBlock(targetUserId: ID!, currentUserId: ID!): Boolean
  createReport(
    initiatorId: ID!
    targetId: ID!
    reason: String!
    description: String
  ): Boolean
}

type Query {
  getPostsByHobbyType(hobbyType: HobbyType): [Post]
  getPostById(id: ID): Post
  getPosts: [Post]
  getProfile(userId: ID!): UserProfile
  getProfileByUsername(username: String!): UserProfile
  getUserPosts(userId: ID!): [Post]
  getFollowers(userId: ID!): [User]
  getFollowing(userId: ID!): [User]
  isFollowing(currentUserId: ID!, targetUserId: ID!): Boolean
  isBlocking(currentUserId: ID!, targetUserId: ID!): Boolean
  getBlockedUsers(userId: ID!): [User]
}

interface Post {
  id: ID
  title: String
  description: String
  userId: ID
  createdAt: String
  updatedAt: String
  mediaSet: [Media]
  hobbyType: String
}

type Gym implements Post {
  id: ID
  title: String
  description: String
  userId: ID
  createdAt: String
  updatedAt: String
  mediaSet: [Media]
  hobbyType: String
  totalDuration: Float
  exercises: [GymExercise]
}

type Reading implements Post {
  id: ID
  title: String
  description: String
  userId: ID
  createdAt: String
  updatedAt: String
  mediaSet: [Media]
  hobbyType: String
  bookTitle: String
  pagesRead: String
  totalPagesRead: String
  bookFinished: Boolean
}

type GymExercise {
  id: ID
  title: String
  reps: Int
  weight: Float
  rpe: Float
}

type Media {
  relevantId: ID
  fileData: String
  contentType: String
  contentFlag: ContentFlag
}

enum HobbyType {
  GYM
  READING
}

enum ContentFlag {
  SAFE
  RISK
  UNASSIGNED
}

type UserProfile {
  id: ID
  username: String
  bio: String
  profilePictureUrl: String
  followerCount: Int
  followingCount: Int
}

type User {
  id: ID
  username: String
  profilePictureUrl: String
}