type Mutation {
  toggleFollow(targetUserId: ID!, currentUserId: ID!): Boolean
  toggleBlock(targetUserId: ID!, currentUserId: ID!): Boolean
  createReport(
    initiatorId: ID!
    targetId: ID!
    reason: String!
    description: String
  ): Boolean
}

type Query {
  getPostsByHobbyType(hobbyType: HobbyType): [Post]
  getPostById(id: ID): Post
  getPosts(page: Int, size: Int, currentUserId: ID): [Post]
  getProfile(userId: ID!): User
  getProfileByUsername(username: String!): User
  getUserPosts(userId: ID!): [Post]
  getFollowers(userId: ID!): [User]
  getFollowing(userId: ID!): [User]
  isFollowing(currentUserId: ID!, targetUserId: ID!): Boolean
  isBlocking(currentUserId: ID!, targetUserId: ID!): Boolean
  getBlockedUsers(userId: ID!): [User]
  getReportedFiles: [ReportedFile]
}

interface Post {
  id: ID
  title: String
  description: String
  userId: ID
  createdAt: String
  updatedAt: String
  mediaSet: [Media]
  hobbyType: String
  interaction: Interaction
  linkedItems: [LinkedHobbyItem]
  authorUsername: String
}

type Gym implements Post {
  id: ID
  title: String
  description: String
  userId: ID
  createdAt: String
  updatedAt: String
  mediaSet: [Media]
  hobbyType: String
  totalDuration: Float
  exercises: [GymExercise]
  interaction: Interaction
  linkedItems: [LinkedHobbyItem]
  authorUsername: String
}

type Reading implements Post {
  id: ID
  title: String
  description: String
  userId: ID
  createdAt: String
  updatedAt: String
  mediaSet: [Media]
  hobbyType: String
  bookTitle: String
  pagesRead: String
  totalPagesRead: String
  bookFinished: Boolean
  interaction: Interaction
  linkedItems: [LinkedHobbyItem]
  authorUsername: String
}

# Other post — no hobby-specific fields, just title/description + linked items
type Other implements Post {
  id: ID
  title: String
  description: String
  userId: ID
  createdAt: String
  updatedAt: String
  mediaSet: [Media]
  hobbyType: String
  interaction: Interaction
  linkedItems: [LinkedHobbyItem]
  authorUsername: String
}

type LinkedHobbyItem {
  hobbyId: String
  externalId: String
  hobbyType: String
  displayName: String
  imageUrl: String
}

type GymExercise {
  id: ID
  title: String
  reps: Int
  weight: Float
  rpe: Float
}

type Media {
  relevantId: ID
  fileData: String
  contentType: String
  contentFlag: ContentFlag
}

type Interaction {
    likes: Int
    comments: [Comment]
}

type Comment {
    id: ID
    referenceId: ID
    userId: ID
    comment: String
}

enum HobbyType {
  GYM
  READING
  OTHER
}

enum ContentFlag {
  SAFE
  RISK
  UNASSIGNED
}

type User {
  id: ID
  username: String
  bio: String
  profilePicture: Media
  followerCount: Int
  followingCount: Int
}

type ReportedFile {
  hash: String
  file: String
  contentType: String
  contentFlag: ContentFlag
}
