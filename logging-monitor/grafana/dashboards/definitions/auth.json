{
  "title": "Auth Service (C)",
  "uid": "authservice",
  "tags": ["auth", "c", "authentication"],
  "timezone": "browser",
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "Total Requests",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "auth_requests_total{service=\"auth\"}",
          "legendFormat": "Total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "none" }
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "Active Connections",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "auth_active_connections{service=\"auth\"}",
          "legendFormat": "Active"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "value": 50, "color": "orange" }, { "value": 100, "color": "red" }] }
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "Heap In Use",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "auth_heap_in_use_bytes{service=\"auth\"}",
          "legendFormat": "Heap"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "value": 52428800, "color": "orange" }, { "value": 104857600, "color": "red" }] },
          "decimals": 1
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "Heap Allocated (Total)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "rate(auth_heap_allocated_total{service=\"auth\"}[1m])",
          "legendFormat": "Alloc rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "value": 1048576, "color": "orange" }, { "value": 5242880, "color": "red" }] },
          "decimals": 1
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "Process RSS",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [
        {
          "expr": "auth_memory_VmRSS{service=\"auth\"}",
          "legendFormat": "RSS"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "value": 52428800, "color": "orange" }, { "value": 104857600, "color": "red" }] },
          "decimals": 1
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "rate(auth_route_requests_total{service=\"auth\"}[1m])",
          "legendFormat": "{{method}} {{path}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rps",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "Errors by Status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "rate(auth_route_requests_total{service=\"auth\", status=~\"4..\"}[1m])",
          "legendFormat": "4xx {{method}} {{path}}"
        },
        {
          "expr": "rate(auth_route_requests_total{service=\"auth\", status=~\"5..\"}[1m])",
          "legendFormat": "5xx {{method}} {{path}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rps",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "Memory Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "auth_memory_VmRSS{service=\"auth\"}",
          "legendFormat": "RSS"
        },
        {
          "expr": "auth_memory_VmSize{service=\"auth\"}",
          "legendFormat": "Virtual"
        },
        {
          "expr": "auth_memory_VmPeak{service=\"auth\"}",
          "legendFormat": "Peak"
        },
        {
          "expr": "auth_heap_in_use_bytes{service=\"auth\"}",
          "legendFormat": "Heap In Use"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "Requests by Route & Status",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "auth_route_requests_total{service=\"auth\"}",
          "legendFormat": "",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "title": "Logs",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "collapsed": false
    },
    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "title": "Error & Warning Rate",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 21 },
      "targets": [
        {
          "expr": "sum by (level) (rate({container=\"authentication-service-c\"} |~ `(?i)(error|warn|fail|exception)` [1m]))",
          "legendFormat": "{{level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "title": "Auth Service Logs",
      "type": "logs",
      "gridPos": { "h": 12, "w": 12, "x": 12, "y": 21 },
      "targets": [
        {
          "expr": "{container=\"authentication-service-c\"}",
          "legendFormat": ""
        }
      ],
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogs": false
      }
    }
  ],
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
  },
  "schemaVersion": 39,
  "version": 3
}
