{
  "title": "Bug Report Service",
  "uid": "bugreportservice",
  "tags": ["go", "prometheus", "logs", "loki", "bug-report"],
  "timezone": "browser",
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(http_requests_total{service=\"bug-report\"}[1m])",
          "legendFormat": "All Requests"
        },
        {
          "expr": "rate(http_requests_total{service=\"bug-report\", status=~\"4..\"}[1m])",
          "legendFormat": "4xx"
        },
        {
          "expr": "rate(http_requests_total{service=\"bug-report\", status=~\"5..\"}[1m])",
          "legendFormat": "5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rps",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "HTTP Response Time (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{service=\"bug-report\"}[1m]))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "Goroutines",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "go_goroutines{service=\"bug-report\"}",
          "legendFormat": "Goroutines"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "value": 50, "color": "orange" }, { "value": 100, "color": "red" }] }
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "Memory Allocated",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 8 },
      "targets": [
        {
          "expr": "go_memstats_alloc_bytes{service=\"bug-report\"}",
          "legendFormat": "Allocated"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "value": 50000000, "color": "orange" }, { "value": 100000000, "color": "red" }] }
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "GC Duration",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "go_gc_duration_seconds{service=\"bug-report\"}",
          "legendFormat": "GC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "value": 0.1, "color": "orange" }, { "value": 0.5, "color": "red" }] }
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "Uptime",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "time() - process_start_time_seconds{service=\"bug-report\"}",
          "legendFormat": "Uptime"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "color": { "mode": "none" }
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "CPU Usage",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 8 },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{service=\"bug-report\"}[1m])",
          "legendFormat": "CPU"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "value": 0.8, "color": "orange" }, { "value": 0.95, "color": "red" }] }
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "Memory Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "go_memstats_alloc_bytes{service=\"bug-report\"}",
          "legendFormat": "Allocated"
        },
        {
          "expr": "go_memstats_stack_inuse_bytes{service=\"bug-report\"}",
          "legendFormat": "Stack Inuse"
        },
        {
          "expr": "go_memstats_heap_inuse_bytes{service=\"bug-report\"}",
          "legendFormat": "Heap Inuse"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "HTTP Requests by Path",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "targets": [
        {
          "expr": "rate(http_requests_total{service=\"bug-report\"}[5m])",
          "legendFormat": "{{method}} {{path}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rps",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "Open FDs",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 8 },
      "targets": [
        {
          "expr": "process_open_fds{service=\"bug-report\"}",
          "legendFormat": "Open FDs"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "value": 100, "color": "orange" }, { "value": 200, "color": "red" }] }
        }
      }
    },
    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "title": "Error & Warning Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "sum(rate({container=\"bug-report-service\"} |= `ERROR` [1m]))",
          "legendFormat": "ERROR"
        },
        {
          "expr": "sum(rate({container=\"bug-report-service\"} |= `WARN` [1m]))",
          "legendFormat": "WARN"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "title": "Errors & Warnings",
      "type": "logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 28 },
      "targets": [
        {
          "expr": "{container=\"bug-report-service\"} |~ `(?i)(error|warn|exception|failed|refused|denied|timeout)`",
          "legendFormat": ""
        }
      ],
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogs": true
      }
    },
    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "title": "All Logs",
      "type": "logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 40 },
      "targets": [
        {
          "expr": "{container=\"bug-report-service\"}",
          "legendFormat": ""
        }
      ],
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogs": false
      }
    }
  ],
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
  },
  "schemaVersion": 39,
  "version": 1
}
