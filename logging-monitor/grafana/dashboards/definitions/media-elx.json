{
  "title": "Media Service ELX",
  "uid": "mediaserviceelx",
  "tags": ["logs", "loki", "media-service", "elixir"],
  "timezone": "browser",
  "panels": [
    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "title": "Error & Warning Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate({app=\"media-service\"} |= `error` [1m]))",
          "legendFormat": "ERROR"
        },
        {
          "expr": "sum(rate({app=\"media-service\"} |= `warning` [1m]))",
          "legendFormat": "WARN"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "title": "Errors & Warnings",
      "type": "logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "{app=\"media-service\"} |~ `(?i)(error|warning|warn|exception|EXIT|badarg|undef|noproc|shutdown|refused|denied|timeout|crashed)`",
          "legendFormat": ""
        }
      ],
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogs": true
      }
    },
    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "title": "Elixir Process Crashes (GenServer / Supervisor)",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "{app=\"media-service\"} |~ `(?i)(GenServer|Supervisor|terminated|child.*terminated|maximum restart|EXIT from)`",
          "legendFormat": ""
        }
      ],
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogs": true
      }
    },
    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "title": "All Logs",
      "type": "logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 30 },
      "targets": [
        {
          "expr": "{app=\"media-service\"}",
          "legendFormat": ""
        }
      ],
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogs": false
      }
    }
  ],
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
  },
  "schemaVersion": 39,
  "version": 1
}