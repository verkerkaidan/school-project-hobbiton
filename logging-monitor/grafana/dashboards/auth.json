{
  "title": "Auth Service (C)",
  "uid": "authservice",
  "tags": ["auth", "c", "authentication"],
  "timezone": "browser",
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "Total Requests",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "auth_requests_total{service=\"auth\"}",
          "legendFormat": "Total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "none" }
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "Active Connections",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "auth_active_connections{service=\"auth\"}",
          "legendFormat": "Active"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "value": 50, "color": "orange" }, { "value": 100, "color": "red" }] }
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "Memory (RSS)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "auth_memory_VmRSS{service=\"auth\"}",
          "legendFormat": "RSS"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "value": 52428800, "color": "orange" }, { "value": 104857600, "color": "red" }] },
          "decimals": 1
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "Virtual Memory",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "auth_memory_VmSize{service=\"auth\"}",
          "legendFormat": "VmSize"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "value": 209715200, "color": "orange" }, { "value": 419430400, "color": "red" }] },
          "decimals": 1
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "Peak VMem",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [
        {
          "expr": "auth_memory_VmPeak{service=\"auth\"}",
          "legendFormat": "Peak"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "value": 314572800, "color": "orange" }, { "value": 524288000, "color": "red" }] },
          "decimals": 1
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "rate(auth_route_requests_total{service=\"auth\"}[1m])",
          "legendFormat": "{{method}} {{path}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rps",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "Errors by Status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "rate(auth_route_requests_total{service=\"auth\", status=~\"4..\"}[1m])",
          "legendFormat": "4xx {{method}} {{path}}"
        },
        {
          "expr": "rate(auth_route_requests_total{service=\"auth\", status=~\"5..\"}[1m])",
          "legendFormat": "5xx {{method}} {{path}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rps",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "Memory Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "auth_memory_VmRSS{service=\"auth\"}",
          "legendFormat": "RSS"
        },
        {
          "expr": "auth_memory_VmSize{service=\"auth\"}",
          "legendFormat": "Virtual"
        },
        {
          "expr": "auth_memory_VmPeak{service=\"auth\"}",
          "legendFormat": "Peak"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "Requests by Route & Status",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "auth_route_requests_total{service=\"auth\"}",
          "legendFormat": "",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" }
        }
      }
    }
  ],
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
  },
  "schemaVersion": 39,
  "version": 2
}
